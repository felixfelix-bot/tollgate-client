# Caps live in the environment so an operator can change them without a rebuild.
# Cost is expressed in the advert's own unit (sat on v1 gates).
TOLLGATE_MAX_COST_PER_MINUTE=2
TOLLGATE_DAILY_BUDGET=100

# Funding: either a pre-funded note (token lane) …
#TOLLGATE_TOKEN_FILE=/var/lib/tollgate/note.txt
# … or a cdk wallet that mints on demand (token lane, needs a reachable mint)
#TOLLGATE_WALLET=cdk
#TOLLGATE_SEED_FILE=/var/lib/tollgate/seed.bin
#TOLLGATE_WALLET_DB=/var/lib/tollgate
